{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Intune Manager",
  "version": "0.1.0",
  "identifier": "com.intunemanager.crossplatform",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Intune Manager",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Cross-platform Microsoft Intune manager",
    "longDescription": "A beautiful, cross-platform desktop GUI for managing Microsoft Intune and Azure AD objects via the Microsoft Graph beta API. Runs on Linux (incl. Omarchy/Wayland), macOS and Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
